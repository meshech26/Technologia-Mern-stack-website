# Node.js backend .gitignore

# Dependencies
# This folder contains all installed packages and can be huge.
# It can be regenerated by anyone using `npm install`.
/node_modules

# Environment Variables
# This file contains secrets like your database connection string and JWT secret.
# NEVER commit this file to a public repository.
.env

# User-Generated Content
# This folder is created by the application to store QR codes.
# It should not be part of the source code.
/uploads

# Logs
# These files are for debugging on your local machine.
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / Editor Directories
# These are specific to your personal editor setup.
.vscode/
.idea/

# Operating System Files
.DS_Store
Thumbs.db